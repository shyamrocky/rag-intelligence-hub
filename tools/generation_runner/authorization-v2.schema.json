{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grounded-generation-authorization-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_sha256",
    "question_ids",
    "preflight_sha256",
    "requests",
    "implementation_bindings",
    "aggregate_cap_usd",
    "per_question_caps_usd",
    "owner_statement",
    "allow_paid_inference",
    "allow_source_transfer",
    "maximum_generation_requests_per_question",
    "expires_at",
    "trust_manifest",
    "trust_manifest_sha256",
    "preservation_receipt"
  ],
  "properties": {
    "schema": {
      "const": "grounded-generation-authorization-2.0"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "question_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "preflight_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_sha256",
          "M7_result_sha256",
          "M8_package_sha256",
          "question_sha256"
        ],
        "properties": {
          "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "M7_result_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "M8_package_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "question_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "implementation_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "aggregate_cap_usd": {
      "type": "string"
    },
    "per_question_caps_usd": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "owner_statement": {
      "type": "string",
      "minLength": 1
    },
    "allow_paid_inference": {
      "const": true
    },
    "allow_source_transfer": {
      "const": true
    },
    "maximum_generation_requests_per_question": {
      "const": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "trust_manifest": {
      "type": "string"
    },
    "trust_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preservation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
